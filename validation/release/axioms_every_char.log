@IDMM.two_mul_le_of_ncSizeLE_ID : ∀ {F : Type u_1} [inst : Field F] {N s : ℕ},
  PauliCubes.NCSizeLE (PauliCubes.ID F N) s → 2 * N ≤ s
@IDMM.not_idBoundF_of_lt_one : ∀ {F : Type u_1} [inst : Field F] {c : ℝ}, c < 1 → ¬IDMM.IDBoundF F c
@IDMM.ncSizeLE_strict : ∀ {K : Type u_1} {V : Type u_2} [inst : CommRing K] {f : FreeAlgebra K V} {s : ℕ},
  PauliCubes.NCSizeLE f s → IDMM.StrictNCSizeLE f (2 * s + 1)
@IDMM.rankAtMost_of_scheme : ∀ {K : Type u_1} [inst : CommRing K] {a b ρ : ℕ}
  (alg : Matmul.UniversalRecursiveAlgorithm.Scheme a b a ρ),
  Matmul.IntegerBilinear.Algorithm.tensor alg = Matmul.IntegerBilinear.matrixTensor a b a →
    (OAI.MatrixMultiplication.Foundation.Tensor.matrixCoefficients (Fin a) (Fin b) (Fin a)).RankAtMost ρ
IDMM.uz_exponent_slack : IDMM.constructionExponent (18 / 29) (200 / 99) + 1 / 10 ^ 5 < 4173 / 2500
@IDMM.construction_gen : ∀ {μ : ℝ} {K : Type u_1} [inst : Field K] [NeZero 2] [IDMM.SqrtNegOne K],
  1 / 2 < μ →
    μ < 1 →
      ∀ {w : ℝ},
        2 ≤ w →
          (∀ (ε : ℝ),
              0 < ε →
                ∃ C,
                  0 < C ∧
                    ∀ (n : ℕ),
                      ∃ M,
                        IDMM.BlockMM (PauliCubes.ncInputs K ((Fin n → Fin 2) ⊕ (Fin n → Fin 2))) (IDMM.mOfMu μ n)
                            (n - IDMM.mOfMu μ n) M ∧
                          ↑M ≤ C * (2 ^ IDMM.mOfMu μ n) ^ (w + ε)) →
            IDMM.IDBoundF K (IDMM.constructionExponent μ w)
@IDMM.oracles_of_scheme : ∀ {K : Type u_1} [inst : Field K] {μ : ℝ},
  1 / 2 < μ →
    μ < 1 →
      ∀ {a b R : ℕ},
        (OAI.MatrixMultiplication.Foundation.Tensor.matrixCoefficients (Fin a) (Fin b) (Fin a)).RankAtMost R →
          2 ≤ a →
            ∀ {τ : ℝ},
              ↑a ^ ((1 - μ) / μ) ≤ ↑b →
                ↑R ≤ ↑a ^ τ →
                  ↑(a * b) ≤ ↑a ^ τ →
                    ↑a ^ 2 ≤ ↑a ^ τ →
                      ∀ {ε : ℝ},
                        0 < ε →
                          ∃ C,
                            0 < C ∧
                              ∀ (n : ℕ),
                                ∃ M,
                                  IDMM.BlockMM (PauliCubes.ncInputs K ((Fin n → Fin 2) ⊕ (Fin n → Fin 2)))
                                      (IDMM.mOfMu μ n) (n - IDMM.mOfMu μ n) M ∧
                                    ↑M ≤ C * (2 ^ IDMM.mOfMu μ n) ^ (τ + ε)
IDMM.exists_ext_of_algClosure : ∀ (F : Type u_1) [inst : Field F] {a b c R : ℕ},
  (OAI.MatrixMultiplication.Foundation.Tensor.matrixCoefficients (Fin a) (Fin b) (Fin c)).RankAtMost R →
    ∃ E x x_1,
      FiniteDimensional F E ∧
        (∃ i, i * i = -1) ∧
          (OAI.MatrixMultiplication.Foundation.Tensor.matrixCoefficients (Fin a) (Fin b) (Fin c)).RankAtMost R
@IDMM.IDBoundF.of_ext : ∀ {F E : Type u_1} [inst : Field F] [inst_1 : Field E] [inst_2 : Algebra F E]
  [FiniteDimensional F E] {c : ℝ}, 0 ≤ c → IDMM.IDBoundF E c → IDMM.IDBoundF F c
@Matmul.RectangularRankBridge.exists_scheme_certificate : ∀ {k ε : ℝ},
  0 ≤ k →
    0 < ε →
      Nonempty
        (Matmul.RectangularRankBridge.SchemeCertificate k (Matmul.RectangularOptimization.rectangularBound k + ε))
@IDMM.StrictNCSizeLE.ncSizeLE : ∀ {K : Type u_1} {V : Type u_2} [inst : CommRing K] {f : FreeAlgebra K V} {s : ℕ},
  IDMM.StrictNCSizeLE f s → PauliCubes.NCSizeLE f s
@IDMM.strict_of_bound : ∀ {F : Type u_1} [inst : Field F] {W : ℕ → Type} {f : (N : ℕ) → FreeAlgebra F (W N)} {c : ℝ},
  0 ≤ c →
    (∀ (ε : ℝ), 0 < ε → ∃ C, 0 < C ∧ ∀ (N : ℕ), 1 ≤ N → PauliCubes.NCSizeLE (f N) ⌊C * ↑N ^ (c + ε)⌋₊) →
      IDMM.StrictBound f c
@IDMM.not_strictIDBoundF_of_lt_one : ∀ {F : Type u_1} [inst : Field F] {c : ℝ}, c < 1 → ¬IDMM.StrictIDBoundF F c
IDMM.strict_id_trivial : ∀ (F : Type u_1) [inst : Field F] (N : ℕ),
  IDMM.StrictNCSizeLE (PauliCubes.ID F N) (2 * (4 * N ^ 2 + 2 * N + 1) + 1)
@IDMM.not_strictNCSizeLE_zero : ∀ {K : Type u_1} {V : Type u_2} [inst : CommRing K] (f : FreeAlgebra K V),
  ¬IDMM.StrictNCSizeLE f 0
