IDMM.id_bound_every_char : ∀ (F : Type u_1) [inst : Field F],
  ringChar F ≠ 2 → IDMM.IDBoundF F (4173 / 2500) ∧ IDMM.S4BoundF F (4173 / 2500) ∧ IDMM.Perm4BoundF F (4173 / 2500)
def IDMM.IDBoundF.{u} : (F : Type u) → [Field F] → ℝ → Prop :=
fun F [Field F] c =>
  ∀ (ε : ℝ), 0 < ε → ∃ C, 0 < C ∧ ∀ (N : ℕ), 1 ≤ N → PauliCubes.NCSizeLE (PauliCubes.ID F N) ⌊C * ↑N ^ (c + ε)⌋₊
def IDMM.S4BoundF.{u} : (F : Type u) → [Field F] → ℝ → Prop :=
fun F [Field F] c =>
  ∀ (ε : ℝ), 0 < ε → ∃ C, 0 < C ∧ ∀ (N : ℕ), 1 ≤ N → PauliCubes.NCSizeLE (PauliCubes.S4 F N) ⌊C * ↑N ^ (c + ε)⌋₊
def IDMM.Perm4BoundF.{u} : (F : Type u) → [Field F] → ℝ → Prop :=
fun F [Field F] c =>
  ∀ (ε : ℝ), 0 < ε → ∃ C, 0 < C ∧ ∀ (N : ℕ), 1 ≤ N → PauliCubes.NCSizeLE (PauliCubes.perm4 F N) ⌊C * ↑N ^ (c + ε)⌋₊
