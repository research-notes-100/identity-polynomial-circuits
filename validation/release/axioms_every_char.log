IDMM.strict_id_bound_every_char : ∀ (F : Type u_1) [inst : Field F],
  ringChar F ≠ 2 →
    IDMM.StrictIDBoundF F (4173 / 2500) ∧ IDMM.StrictS4BoundF F (4173 / 2500) ∧ IDMM.StrictPerm4BoundF F (4173 / 2500)
IDMM.id_bound_every_char_rat : IDMM.IDBoundF ℚ (4173 / 2500) ∧
  IDMM.S4BoundF ℚ (4173 / 2500) ∧ IDMM.Perm4BoundF ℚ (4173 / 2500)
IDMM.id_bound_every_char_zmod3 : IDMM.IDBoundF (ZMod 3) (4173 / 2500) ∧
