IDMM.thin_main : IDMM.IDBound (16939 / 10000) ∧ IDMM.S4Bound (16939 / 10000) ∧ IDMM.Perm4Bound (16939 / 10000)
@IDMM.construction_gen : ∀ {μ : ℝ} {K : Type u_1} [inst : Field K] [NeZero 2] [IDMM.SqrtNegOne K],
  1 / 2 < μ →
    μ < 1 →
      ∀ {w : ℝ},
        2 ≤ w →
          (∀ (ε : ℝ),
              0 < ε →
                ∃ C,
                  0 < C ∧
                    ∀ (n : ℕ),
                      ∃ M,
                        IDMM.BlockMM (PauliCubes.ncInputs K ((Fin n → Fin 2) ⊕ (Fin n → Fin 2))) (IDMM.mOfMu μ n)
                            (n - IDMM.mOfMu μ n) M ∧
                          ↑M ≤ C * (2 ^ IDMM.mOfMu μ n) ^ (w + ε)) →
            IDMM.IDBoundF K (IDMM.constructionExponent μ w)
IDMM.construction_target : IDMM.ConditionalTarget
def IDMM.MainTarget : Prop :=
IDMM.IDBound IDMM.targetExponent ∧ IDMM.S4Bound IDMM.targetExponent ∧ IDMM.Perm4Bound IDMM.targetExponent
def IDMM.ConditionalTarget : Prop :=
∀ (μ w : ℝ),
  1 / 2 < μ →
    μ < 1 →
      OAI.MatrixMultiplication.Arithmetic.RectangularAdmissibleExponent ℂ ((1 - μ) / μ) w →
        IDMM.IDBound (IDMM.constructionExponent μ w)
