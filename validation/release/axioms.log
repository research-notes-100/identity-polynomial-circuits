def IDMM.StrictNCSizeLE.{u_1, u_2} : {K : Type u_1} →
  {V : Type u_2} → [inst : CommRing K] → FreeAlgebra K V → ℕ → Prop :=
fun {K} {V} [CommRing K] f s => ∃ gs, IDMM.StrictBuilds (PauliCubes.ncInputs K V) gs ∧ gs.length ≤ s ∧ f ∈ gs
def IDMM.StrictBuilds.{u_1} : {R : Type u_1} → [Ring R] → Set R → List R → Prop :=
fun {R} [Ring R] inp gs =>
  ∀ (k : ℕ) (g : R),
    gs[k]? = some g →
      g ∈ inp ∨ ∃ i j a b, i < k ∧ j < k ∧ i ≠ j ∧ gs[i]? = some a ∧ gs[j]? = some b ∧ (g = a + b ∨ g = a * b)
