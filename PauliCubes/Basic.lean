/-
Shared definitions for the proof of `MainTarget`: the cube-cover cost of a letter-frequency vector, the
invariant polynomials q₁, q₂, q₄, q₆, q₈ of the group generated by letter permutations and the involution
T(x)ᵢ = s/2 − xᵢ (s = x₀ + x₁ + x₂ + x₃), the normal monomials and their two leading exponent vectors.
-/
import PauliCubes.Defs
import Mathlib.Analysis.Convex.StdSimplex
import Mathlib.Analysis.SpecialFunctions.Log.Base
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.Algebra.MvPolynomial.Monad
import Mathlib.Algebra.MvPolynomial.Rename

open Finset MvPolynomial

namespace PauliCubes

/-! ## The cube-cover cost -/

/-- The six two-element sets of letters, as ordered pairs `(a, b)` with `a < b`. -/
abbrev Pair := {p : Fin 4 × Fin 4 // p.1 < p.2}

/-- The probability that letter `a` lies in a pair drawn from `μ`. -/
noncomputable def marg (μ : Pair → ℝ) (a : Fin 4) : ℝ :=
  ∑ p : Pair, if p.1.1 = a ∨ p.1.2 = a then μ p else 0

/-- Distributions on pairs under which every letter has positive inclusion probability. -/
def PairDist : Set (Pair → ℝ) :=
  {μ | (∀ p, 0 ≤ μ p) ∧ ∑ p, μ p = 1 ∧ ∀ a, 0 < marg μ a}

/-- **Cube-cover cost** of a letter-frequency vector `x` (meaningful on the standard simplex):
`1 + inf_μ Σ_a x_a log₂(1 / q_a(μ))`. Drawing one pair per position from `μ`, a fixed word of type `n`
(frequencies `x = n/λ`) lies in the random cube with probability `2^(-λ (cost - 1))` for the best `μ`. -/
noncomputable def cubeCost (x : Fin 4 → ℝ) : ℝ :=
  1 + ⨅ μ : PairDist, ∑ a, x a * Real.logb 2 (1 / marg μ.1 a)

/-- The type of a word: how many times each letter occurs. -/
def wordType {n : ℕ} (ν : Fin n → Fin 4) (a : Fin 4) : ℕ := (univ.filter fun i => ν i = a).card

/-- A natural-number vector as a real point. -/
def toPt (n : Fin 4 → ℕ) : Fin 4 → ℝ := fun a => (n a : ℝ)

/-- A type of total `d`, normalized to a frequency vector. -/
noncomputable def normPt (n : Fin 4 → ℕ) (d : ℕ) : Fin 4 → ℝ := fun a => (n a : ℝ) / d

/-! ## The invariant polynomials -/

variable (K : Type*) [Field K]

/-- The substitution `T(x)ᵢ = s/2 − xᵢ`, `s = x₀ + x₁ + x₂ + x₃`. -/
noncomputable def Tsub : Fin 4 → MvPolynomial (Fin 4) K :=
  fun i => C (2 : K)⁻¹ * (X 0 + X 1 + X 2 + X 3) - X i

/-- Invariance under all letter permutations and under `T`. -/
def GInvariant (F : MvPolynomial (Fin 4) K) : Prop :=
  (∀ σ : Equiv.Perm (Fin 4), rename σ F = F) ∧ bind₁ (Tsub K) F = F

/-- q₁ = a + b + c + d. -/
noncomputable def q1 : MvPolynomial (Fin 4) K := X 0 + X 1 + X 2 + X 3

/-- q₂ = the second elementary symmetric polynomial. -/
noncomputable def q2 : MvPolynomial (Fin 4) K :=
  X 0 * X 1 + X 0 * X 2 + X 0 * X 3 + X 1 * X 2 + X 1 * X 3 + X 2 * X 3

/-- q₄ = the sum of the 12 distinct permutations of a²bc. -/
noncomputable def q4 : MvPolynomial (Fin 4) K :=
  X 0 ^ 2 * (X 1 * X 2 + X 1 * X 3 + X 2 * X 3) + X 1 ^ 2 * (X 0 * X 2 + X 0 * X 3 + X 2 * X 3) +
  X 2 ^ 2 * (X 0 * X 1 + X 0 * X 3 + X 1 * X 3) + X 3 ^ 2 * (X 0 * X 1 + X 0 * X 2 + X 1 * X 2)

/-- q₆ = (ab + cd)(ac + bd)(ad + bc). -/
noncomputable def q6 : MvPolynomial (Fin 4) K :=
  (X 0 * X 1 + X 2 * X 3) * (X 0 * X 2 + X 1 * X 3) * (X 0 * X 3 + X 1 * X 2)

/-- q₈ = abcd (q₁ − 2a)(q₁ − 2b)(q₁ − 2c)(q₁ − 2d). -/
noncomputable def q8 : MvPolynomial (Fin 4) K :=
  X 0 * X 1 * X 2 * X 3 * ((q1 K - 2 * X 0) * (q1 K - 2 * X 1) * (q1 K - 2 * X 2) * (q1 K - 2 * X 3))

/-- Exponents of a normal monomial `q₁^u q₂^v q₄^w q₆^b q₈^a`, with `u < 2` or `b = 0`. -/
@[ext] structure NormalMono where
  u : ℕ
  v : ℕ
  w : ℕ
  b : ℕ
  a : ℕ
  normal : u < 2 ∨ b = 0
  deriving DecidableEq

namespace NormalMono

/-- The degree `u + 2v + 4w + 6b + 8a`. -/
def deg (m : NormalMono) : ℕ := m.u + 2 * m.v + 4 * m.w + 6 * m.b + 8 * m.a

/-- The polynomial `q₁^u q₂^v q₄^w q₆^b q₈^a`. -/
noncomputable def poly (m : NormalMono) : MvPolynomial (Fin 4) K :=
  q1 K ^ m.u * q2 K ^ m.v * q4 K ^ m.w * q6 K ^ m.b * q8 K ^ m.a

/-- The leading exponent in chamber A (weights z₀ > z₁ > z₂ > z₃ with z₀ + z₃ > z₁ + z₂). -/
def A (m : NormalMono) : Fin 4 → ℕ :=
  ![m.u + m.v + 2 * m.w + 3 * m.b + 5 * m.a, m.v + m.w + m.b + m.a, m.w + m.b + m.a, m.b + m.a]

/-- The leading exponent in chamber B (weights z₀ > z₁ > z₂ > z₃ with z₀ + z₃ < z₁ + z₂). -/
def B (m : NormalMono) : Fin 4 → ℕ :=
  ![m.u + m.v + 2 * m.w + 2 * m.b + 5 * m.a, m.v + m.w + 2 * m.b + m.a, m.w + 2 * m.b + m.a, m.a]

end NormalMono

end PauliCubes
